generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model Account{
  id Int @id @default(autoincrement())
  name String
  email String
  password String

  pokemons Pokemon[]
}
model Pokemon{
  id Int @id @default(autoincrement())
  name String 
  ivId Int 
  typeId Int 
  accountId Int

  iv IV @relation(fields: [ivId], references: [id])
  type PokemonType @relation(fields: [typeId], references : [id])
  account Account @relation(fields: [accountId], references: [id])
}
model IV{
  id Int @id @default(autoincrement())
  attack Int
  hp Int
  defense Int

  pokemon Pokemon[]
}

model PokemonType{
  id Int @id @default(autoincrement())
  type String
  icon String

  pokemon Pokemon[]
}
